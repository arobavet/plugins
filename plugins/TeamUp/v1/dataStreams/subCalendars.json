        { "name": "color", "displayName": "Color", "shape": "number" },
        { "name": "overlap", "displayName": "Allows Overlapping Events", "shape": "boolean" },
        { "name": "readonly", "displayName": "Read-Only", "shape": "boolean" },
        { "name": "type", "displayName": "Type", "shape": "number" },
        { "name": "remote_id", "displayName": "Remote ID", "shape": "string" },
        { "name": "creation_dt", "displayName": "Created At", "shape": "date" }
