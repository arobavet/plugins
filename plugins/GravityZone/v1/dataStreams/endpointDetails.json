{
    "name": "endpointDetails",
    "displayName": "Endpoint Details",
    "description": "Agent, policy, malware status, and module status for one or more endpoints",
    "tags": ["Endpoint"],
    "baseDataSourceName": "httpRequestScopedSingle",
    "config": {
        "httpMethod": "post",
        "endpointPath": "network",
        "postBody": {
            "jsonrpc": "2.0",
            "method": "getManagedEndpointDetails",
            "params": { "endpointId": "{{object.rawId}}" },
            "id": "{{Date.now()}}"
        },
        "pathToData": "result",
        "expandInnerObjects": true,
        "errorHandling": { "type": "path", "realm": "payload", "path": "error.message" }
    },
    "matches": {
        "sourceType": {
            "type": "oneOf",
            "values": ["GravityZone Endpoint"]
        }
    },
    "metadata": [
        { "name": "name", "displayName": "Endpoint", "shape": "string", "role": "label" },
        { "name": "companyId", "shape": "string", "visible": false },
        {
            "name": "companyName",
            "displayName": "Company",
            "sourceId": "companyId",
            "sourceType": "GravityZone Company",
            "objectPropertyPath": "name"
        },
        { "name": "operatingSystem", "displayName": "OS", "shape": "string" },
        { "name": "ip", "displayName": "IP Address", "shape": "string" },
        { "name": "lastSeen", "displayName": "Last Seen", "shape": "date" },
        { "name": "malwareStatus.detection", "visible": false },
        {
            "name": "malwareDetectionState",
            "displayName": "Malware Detected (24h)",
            "computed": true,
            "valueExpression": "{{ $['malwareStatus.detection'] ? 'warning' : 'unmonitored' }}",
            "shape": "state"
        },
        { "name": "malwareStatus.infected", "visible": false },
        {
            "name": "stillInfectedState",
            "displayName": "Still Infected",
            "computed": true,
            "valueExpression": "{{ $['malwareStatus.infected'] ? 'error' : 'unmonitored' }}",
            "shape": "state"
        },
        { "name": "policy.name", "displayName": "Policy", "shape": "string" },
        { "name": "policy.applied", "visible": false },
        {
            "name": "policyAppliedState",
            "displayName": "Policy Applied",
            "computed": true,
            "valueExpression": "{{ $['policy.applied'] ? 'success' : 'warning' }}",
            "shape": "state"
        },
        { "name": "modules.encryption", "visible": false },
        {
            "name": "encryptionState",
            "displayName": "Encryption Enabled",
            "computed": true,
            "valueExpression": "{{ $['modules.encryption'] ? 'success' : 'warning' }}",
            "shape": "state"
        },
        { "name": "agent.productVersion", "displayName": "Agent Version", "shape": "string" },
        { "name": "agent.lastUpdate", "displayName": "Last Signature Update", "shape": "date" },
        { "pattern": ".*" }
    ],
    "timeframes": false
}
