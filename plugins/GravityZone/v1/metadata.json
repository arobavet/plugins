{
    "name": "gravityzone",
    "displayName": "Bitdefender GravityZone",
    "version": "1.1.0",
    "author": { "name": "@arobavet", "type": "community" },
    "description": "Monitor your Bitdefender GravityZone managed estate — companies, endpoints, security policies, and quarantined items.",
    "category": "Security",
    "type": "hybrid",
    "schemaVersion": "2.1",
    "importNotSupported": false,
    "restrictedToPlatforms": [],
    "keywords": ["security", "endpoint protection", "antivirus", "msp", "bitdefender", "gravityzone"],
    "objectTypes": ["GravityZone Company", "GravityZone Endpoint"],
    "links": [
        {
            "category": "documentation",
            "url": "https://github.com/squaredup/plugins/blob/main/plugins/GravityZone/v1/docs/README.md",
            "label": "Help adding this plugin"
        },
        {
            "category": "source",
            "url": "https://github.com/squaredup/plugins/tree/main/plugins/GravityZone/v1",
            "label": "Repository"
        }
    ],
    "base": {
        "plugin": "WebAPI",
        "majorVersion": "1",
        "config": {
            "baseUrl": "{{accessUrl}}/v1.0/jsonrpc",
            "authMode": "basic",
            "basicAuthUsername": "{{apiKey}}",
            "basicAuthPassword": "",
            "headers": [{ "key": "Content-Type", "value": "application/json" }],
            "queryArgs": []
        }
    }
}
