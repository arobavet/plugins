                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Policy Applied",
                    "description": "Whether the assigned security policy is applied on the endpoint",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "policyAppliedState",
                                "linkColumn": "none",
                                "columns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "7d11dae9-8291-42f8-a6f3-3a486505bb49",
                "x": 3,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Encryption Enabled",
                    "description": "Whether the encryption module is enabled on the endpoint",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "encryptionState",
                                "linkColumn": "none",
                                "columns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "a0909eb3-26f0-44bc-92b2-604ab539e482",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Endpoint Details",
                    "description": "Agent, policy, and OS details for the selected endpoint(s)",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["name", "asc"]] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "name",
                                    "companyName",
                                    "policy.name",
                                    "operatingSystem",
                                    "ip",
                                    "agent.productVersion",
                                    "agent.lastUpdate",
                                    "lastSeen"
                                ]
                            }
                        }
                    }
                }
            }
        ]
    }
}
