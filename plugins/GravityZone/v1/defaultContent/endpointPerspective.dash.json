{
    "name": "Endpoint Perspective",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": ["{{variables.[Endpoint]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "a0909eb3-26f0-44bc-92b2-604ab539e482",
                "x": 0,
                "y": 0,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Endpoint Details",
                    "description": "Agent, policy, malware status, and module status for the selected endpoint(s)",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false
                            }
                        }
                    }
                }
            }
        ]
    }
}
