{
    "name": "Endpoint Perspective",
    "schemaVersion": "1.5",
    "timeframe": "none",
    "variables": ["{{variables.[Endpoint]}}"],
    "dashboard": {
        "_type": "layout/grid",
        "columns": 4,
        "version": 1,
        "contents": [
            {
                "i": "0720e7db-fd16-45dc-b0e6-abc96022bf4c",
                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Still Infected",
                    "description": "Whether the endpoint is currently infected",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "stillInfectedState",
                                "linkColumn": "none",
                                "columns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "a3557bac-ba1c-4e06-9f6b-ea7eee79c839",
                "x": 1,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Malware Detected (24h)",
                    "description": "Whether malware was detected on the endpoint in the last 24 hours",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[endpointDetails]}}",
                        "name": "endpointDetails",
                        "pluginConfigId": "{{configId}}"
                    },
                    "scope": {
                        "scope": "{{scopes.[Endpoints]}}",
                        "workspace": "{{workspaceId}}",
                        "variable": "{{variables.[Endpoint]}}"
                    },
                    "variables": ["{{variables.[Endpoint]}}"],
                    "visualisation": {
                        "type": "data-stream-blocks",
                        "config": {
                            "data-stream-blocks": {
                                "labelColumn": "name",
                                "stateColumn": "malwareDetectionState",
                                "linkColumn": "none",
                                "columns": 2
                            }
                        }
                    }
                }
            },
            {
                "i": "98b31b96-5af0-4242-9162-f447012c846d",
                "x": 2,
