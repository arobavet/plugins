                "x": 0,
                "y": 0,
                "w": 1,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Total Companies",
                    "description": "",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "datastream-properties",
                        "name": "properties",
                        "group": { "by": [], "aggregate": [{ "type": "count" }] }
                    },
                    "scope": {
                        "scope": "{{scopes.[Companies]}}",
                        "workspace": "{{workspaceId}}"
                    },
                    "visualisation": {
                        "type": "data-stream-scalar",
                        "config": {
                            "data-stream-scalar": {
                                "value": "count",
                                "comparisonColumn": "none",
                                "label": "Total Companies"
                            }
                        }
                    }
                }
            },
            {
                "i": "9ffd14c3-37a7-4def-922e-11477b75f0bb",
                "x": 1,
                "y": 0,
                "w": 3,
                "h": 2,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Policies by Company",
                    "description": "Number of security policies configured per company",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[policies]}}",
                        "name": "policies",
                        "pluginConfigId": "{{configId}}",
                        "group": {
                            "by": [["companyName", "uniqueValues"]],
                            "aggregate": [{ "type": "count" }]
                        },
                        "sort": { "by": [["count", "desc"]], "top": 15 }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": ["companyName_uniqueValues", "count"],
                                "columnDisplayNames": {
                                    "companyName_uniqueValues": "Company",
                                    "count": "Policies"
                                }
                            }
                        }
                    }
                }
            },
            {
                "i": "14546a64-a252-4f73-80a1-0969d1158bf4",
                "x": 0,
                "y": 2,
                "w": 4,
                "h": 4,
                "moved": false,
                "static": false,
                "z": 0,
                "config": {
                    "_type": "tile/data-stream",
                    "title": "Quarantine Items",
                    "description": "Recently quarantined files across all managed endpoints",
                    "timeframe": "none",
                    "activePluginConfigIds": ["{{configId}}"],
                    "dataStream": {
                        "id": "{{dataStreams.[quarantineItems]}}",
                        "name": "quarantineItems",
                        "pluginConfigId": "{{configId}}",
                        "sort": { "by": [["quarantinedOn", "desc"]] }
                    },
                    "visualisation": {
                        "type": "data-stream-table",
                        "config": {
                            "data-stream-table": {
                                "transpose": false,
                                "columnOrder": [
                                    "endpointName",
                                    "quarantinedOn",
                                    "actionStatus",
                                    "endpointIP",
                                    "canBeRestored"
                                ],
                                "hiddenColumns": ["id", "companyId"]
                            }
                        }
                    }
                }
            }
        ]
    }
}
